<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/hud_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/deathmatch_menu.vcss_c" />
	</styles>

	<!--
		Deathmatch - the mouse menu: !gun (no weapon name), !dm and the spawns editor. Driven by
		source/Deathmatch/Services/MenuHud.cs (the panel) and Functions/HudMenus.cs (what it shows, what a
		click does). GENERATED by hud/tools/gen_deathmatch_menu.py - edit the generator, not this file.

		Replaces the "Deathmatch Menu" / "Sounds" / "Functions" center menus, the "Spawns Editor" center
		menu, and the allowed-weapons list !gun printed in chat. With Hud.Enabled or Hud."Menu" false the
		plugin opens the old center menus instead.

		CONTRACT (MenuHud.cs must match)
		  RootPanelId = "DeathmatchMenuRoot"   RevealClass = "show"   CloseButtonId = "dmm_close"   RowCount = 0
		  CaptureInput = true                  HideHud = None         SharedText = false

		The root is the full screen and draws nothing; the card inside carries the reveal.

		TABS  dmm_tab0 weapons, dmm_tab1 settings, dmm_tab2 spawns (root admins only); pages dmm_pg0..2

		POOLS
		  dmm_p0..dmm_p23     primary tiles, 4 rows of 6 (dmm_prow0..3)
		  dmm_s0..dmm_s11     secondary tiles, 2 rows of 6 (dmm_srow0..1)
		  dmm_chip0..4        the mode's rules            dmm_u0..3   what the mode also gives (icons)
		  dmm_cC_rR           settings rows, 2 columns of 9; each a heading, up to 6 option buttons, or a go button

		BUTTONS (PanelAction.Button, by id)
		  dmm_close                          close (the library handles it)
		  dmm_tabN                           switch tab
		  dmm_pN dmm_sN                      pick that weapon
		  dmm_cC_rR_oO dmm_cC_rR_go          set a preference / open another plugin's menu
		  dmm_sp_addct dmm_sp_addt dmm_sp_rm dmm_sp_save    the spawns editor

		DIALOG VARIABLES
		  dmm_title dmm_tag dmm_now_k dmm_now dmm_next_k dmm_next dmm_tabN
		  dmm_chipN dmm_also_k dmm_note
		  dmm_p_k dmm_p_saved_k dmm_p_saved dmm_s_k dmm_s_saved_k dmm_s_saved   dmm_pN_n dmm_pN_c dmm_sN_n dmm_sN_c
		  dmm_cC_rR_k dmm_cC_rR_sc dmm_cC_rR_oO_t dmm_cC_rR_go_t dmm_set_empty
		  dmm_sp_ct dmm_sp_ct_k dmm_sp_t dmm_sp_t_k dmm_sp_dirty dmm_sp_addct dmm_sp_addt dmm_sp_rm dmm_sp_save dmm_sp_hint
		  dmm_status dmm_cmd dmm_cmd_t

		CLASSES THE SERVER TOGGLES
		  dmm_body           bh-8 .. bh-24       (the body height, 20px a step, so switching tabs never resizes the card)
		  dmm_bar            at-0 .. at-2        (the underline under the active tab)
		  dmm_tabN dmm_pgN   active              dmm_tab2   hidden
		  dmm_pg0            rand                (random weapons: the tiles only show what the mode hands out)
		  dmm_chipN          hidden | warn | gold
		  dmm_also dmm_note dmm_next   hidden    dmm_uN   hidden | u-<item>
		  dmm_psec dmm_ssec dmm_prowN dmm_srowN   hidden
		  dmm_pN dmm_sN      hidden | sel | locked | w-<weapon>        dmm_pN_c dmm_sN_c   hidden | full
		  dmm_cC_rR          hidden | kind-head | kind-go              dmm_cC_rR_oO   hidden | sel
		  dmm_set_empty dmm_sp_dirty   hidden
		  dmm_status         ok | warn
	-->
